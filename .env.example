APP_ENVIRONMENT=development
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.data/weather
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
SUPABASE_BUCKET=weather-data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_USERNAME=reviewer
AUTH_PASSWORD_HASH=pbkdf2_sha256$600000$replace-salt$replace-hash
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_MINUTES=120
MAX_STORED_FILES=100
